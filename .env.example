# HTTP
PORT=3000

# Which parts of the process start: api, consumer, outbox, pending. Default: all.
ROLES=api,consumer,outbox,pending

# Postgres (POSTGRES_* are read by docker-compose; keep DATABASE_URL in sync)
POSTGRES_USER=wagering
POSTGRES_PASSWORD=wagering
POSTGRES_DB=wagering
DATABASE_URL=postgres://wagering:wagering@localhost:5432/wagering
DB_POOL_MAX=10

# SQS (ministack accepts any credentials)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://localhost:4566
SQS_QUEUE_NAME=wager-transactions.fifo
SQS_DLQ_NAME=wager-transactions-dlq.fifo
SQS_VISIBILITY_TIMEOUT_S=60
SQS_SHUTDOWN_GRACE_MS=10000
