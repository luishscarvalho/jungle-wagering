# HTTP
PORT=3000

# Postgres (POSTGRES_* are read by docker-compose; keep DATABASE_URL in sync)
POSTGRES_USER=wagering
POSTGRES_PASSWORD=wagering
POSTGRES_DB=wagering
DATABASE_URL=postgres://wagering:wagering@localhost:5432/wagering

# SQS (ministack accepts any credentials)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://localhost:4566
SQS_QUEUE_NAME=wager-transactions.fifo
